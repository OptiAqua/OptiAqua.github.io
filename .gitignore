# ============================================================
# OptiAqua Analytics — .gitignore
# ============================================================

# Node.js
node_modules/
npm-debug.log*

# Environment / Secrets — NEVER commit these
.env
*.env
sync/.env

# Firebase Service Account Keys — NEVER commit these
*.json
!package.json
!sync/package.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
*.suo
*.user
