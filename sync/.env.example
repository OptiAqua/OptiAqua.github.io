# ============================================================
# FIREBASE CREDENTIALS
# Choose ONE method:
#
# Method 1 -- RECOMMENDED for server deploy (easiest):
#   1. Go to Firebase Console > Project Settings > Service Accounts
#   2. Click "Generate new private key" -- downloads a .json file
#   3. Copy that .json file to the server (NEVER commit it to git)
#   4. Set the path below
# ============================================================
GOOGLE_APPLICATION_CREDENTIALS=/path/to/optiaqua-serviceaccount.json

# Method 2 -- env vars (if you prefer not to use a file):
# FIREBASE_PROJECT_ID=optiaqua-1844b
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@optiaqua-1844b.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ============================================================
# SQL SERVER — SALES / BIDS / SHOP (EpicorLive)
# ============================================================
SQL_EPICOR_SERVER=aquaerpdb
SQL_EPICOR_DB=EpicorLive
SQL_EPICOR_USER=odbcuser
SQL_EPICOR_PASS=odbcuser

# ============================================================
# SQL SERVER — SHIPPING / ORDERS (Neptune)
# ============================================================
SQL_NEPTUNE_SERVER=aqua26
SQL_NEPTUNE_DB=Neptune
SQL_NEPTUNE_USER=odbcuser
SQL_NEPTUNE_PASS=odbcuser

# ============================================================
# SQL SERVER — WARRANTY / SERVICE (AquaAerobic)
# ============================================================
SQL_AQUA_SERVER=aqua18
SQL_AQUA_DB=AquaAerobic
SQL_AQUA_USER=odbcuser
SQL_AQUA_PASS=odbcuser

# ============================================================
# SSRS REPORT SERVER
# ============================================================
SSRS_BASE_URL=http://aquaerprep/Reports
SSRS_HR_REPORT=/report/ITReports/AquaEmployeeStatus

# ============================================================
# SYNC SCHEDULE (cron format — default: 6am, 12pm, 6pm)
# ============================================================
SYNC_SCHEDULE=0 6,12,18 * * *
