          <DataField>PrimarySalesRep</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BidDate">
          <DataField>BidDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Status">
          <DataField>Status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Product">
          <DataField>Product</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TotalGrossSellPrice">
          <DataField>TotalGrossSellPrice</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="GM">
          <DataField>GM</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="List">
          <DataField>List</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="MeetingComments">
          <DataField>MeetingComments</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProdCode">
          <DataField>ProdCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BIDFormat">
          <DataField>BIDFormat</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DeliveryMethod">
          <DataField>DeliveryMethod</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Mun">
          <DataField>Mun</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Products">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@ProductGroup">
            <Value>=Parameters!ProductGroup.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText> 

select ProdGrup='UnKnown',	Description	='', ProdCode='',	ProCodeLabel =''

union all

select *, ProCodeLabel = ProdCode + ' - ' + Description from 
( 


select distinct  
 ProdGrup= case  when "ProdGrup"."Character01" ='Disinfection'  then 'OZONE'  
  When "Character01"='' then 'Other'
								when "ProdGrup"."Character01" like  '%ZOne%' then 'RP Parts Group'  
								 when "ProdGrup"."Character01" in ('null','') then 'Undentified'
								when "ProdGrup"."Character01" like  '%Part%' then 'RP Parts Group' 
								when "ProdGrup"."Character01" like  '%ZOne%' then 'RP Parts Group'  
								else "ProdGrup"."Character01"  end  , Description, ProdCode  --, ProdCode, Description
FROM     aquaerpdb."Reports"."dbo"."ProdGrup" "ProdGrup"  
where --Character01&lt;&gt;'' and
 "Company"=N'DD-1'  and ProdCode in (select distinct ProdCode from aquaerpdb."Reports"."dbo"."QuoteDtl")
)a
 where ProdGrup in (@ProductGroup)
 

 order by
 ProdGrup</CommandText>
      </Query>
      <Fields>
        <Field Name="ProdGrup">
          <DataField>ProdGrup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Description">
          <DataField>Description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProdCode">
          <DataField>ProdCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProCodeLabel">
          <DataField>ProCodeLabel</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ProdGroup">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText> 
 select ProdGrup='Unknown'
union all
select distinct  
 ProdGrup= case  when "ProdGrup"."Character01" ='Disinfection'  then 'OZONE'  
  When "Character01"='' then 'Other'
								when "ProdGrup"."Character01" like  '%ZOne%' then 'RP Parts Group'  
								 when "ProdGrup"."Character01" in ('null','') then 'Undentified'
								when "ProdGrup"."Character01" like  '%Part%' then 'RP Parts Group' 
								when "ProdGrup"."Character01" like  '%ZOne%' then 'RP Parts Group'  
								else "ProdGrup"."Character01"  end --, Description, ProdCode  --, ProdCode, Description
FROM     aquaerpdb."Reports"."dbo"."ProdGrup" "ProdGrup"  
where --Character01&lt;&gt;'' and
 "Company"=N'DD-1'  and ProdCode in (select distinct ProdCode from aquaerpdb."Reports"."dbo"."QuoteDtl")</CommandText>
      </Query>
      <Fields>
        <Field Name="ProdGrup">
          <DataField>ProdGrup</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Region">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>
Select RegionCode='UNKNOWN',	Region=''
union all
 
SELECT [RegionCode],[Description] AS [Region] FROM [AQUAERPDB].[Epicor10Live].[Erp].[Region] WHERE [Company] = 'DD-1'</CommandText>
      </Query>
      <Fields>
        <Field Name="RegionCode">
          <DataField>RegionCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Region">
          <DataField>Region</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
