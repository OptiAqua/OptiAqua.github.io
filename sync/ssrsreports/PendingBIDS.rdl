<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource1">
      <DataSourceReference>/Epicor10Live/reports/Aqua26_Neptune</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>c9748e28-0532-4f38-b44f-33c4d0807625</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@AftermarketYN">
            <Value>=Parameters!AftermarketYN.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ByDate">
            <Value>=Parameters!ByDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Region">
            <Value>=Parameters!Region.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Product">
            <Value>=Parameters!Product.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Start">
            <Value>=Parameters!Start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@End">
            <Value>=Parameters!End.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--declare @AftermarketYN as varchar(50) ='Y'

declare @data table (AftermarketYN   Varchar(50),
ProjectName  Varchar(50),
ProjectID   Varchar(50),
State   Varchar(50),
QuoteNum   Varchar(50),
Region  Varchar(50),
PrimarySalesRep Varchar(50),
BidDate   Varchar(50),
Status  Varchar(50),
Product  Varchar(50),
TotalGrossSellPrice  float,
GM   float,
List  Varchar(50),
MeetingComments  Varchar(50),
ProdCode  Varchar(50),
BIDFormat  Varchar(50),
DeliveryMethod  Varchar(50),
Mun  Varchar(10)

)
 
 
 
 insert into @data


 
SELECT [MainTable].[AftermarketYN]
	  ,[MainTable].[Project Name]
	  ,[MainTable].[ProjectID]
	  ,[MainTable].[State]
	  ,[MainTable].[QuoteNum]
	  ,Region=Isnull([MainTable].[Region],'') 
	  ,PrimarySalesRep=Isnull([MainTable].[PrimarySalesRep] ,'') --AS [Rep Firm/Primary Sales Rep]
	  ,BIDDate=[MainTable].[Bid Date]
	  ,[MainTable].[Status]
	  ,Product=Isnull([PriceTable1].[Product],'') --AS [Product(s)]
	  ,TotalGrossSellPrice=Isnull([PriceTable1].[TotalGrossSellPrice],0)-- AS [Approx. Value]
	  ,GM=Isnull([PriceTable1].[Price Level],0) --AS [% GM]
	  ,List=isnull([MainTable].[List (100% / Reserve / Watch / None)],'')
	  ,'' AS [Meeting Comments] ,ProdCode=isnull([PriceTable1].ProdCode,''),
	  BidFormat= case when BidFormat in ('ALLOWANCE BID','BASIS OF BID W/DEDUCTIVE ALT','BASIS OF BID/BASIS OF AWARD') then 'BB'
				when BidFormat in ('DEVELOPER DIRECT PURCHASE','OWNER DIRECT PURCHASE','OWNR DRCT PRCH W/ASSGN CONTR') then 'DP'
				when BidFormat in ('DIRECT','DIRECT BID','DIRECT BID/EVALUATED','evaluated prior to bid','evaluated selection prior to bid') then 'P'
				else BidFormat end , 
	DeliveryMethod= case when DeliveryMethod like '%Traditional%' then 'DBB' else DeliveryMethod end , Mun 
FROM
(SELECT DISTINCT [APD1].[ProjectName] AS [Project Name]
	 --DISTINCT used to remove duplicate records caused by reps assigned to more than one territory
	  ,[APD1].[ProjectID]
	  ,[APD1].[State] AS [State]
	  ,[APD1].[QuoteNum]
	  ,[Region2].[Region] AS [Region]
	  ,[RepTable].[Name] AS [PrimarySalesRep]
	  ,[QuoteHed1].[DateQuoted] AS [Bid Date]
      ,[APD1].[Status] AS [Status]
	  ,[QuoteHed1UD].[List] AS [List (100% / Reserve / Watch / None)]
	  ,(CASE WHEN [APD1].[ProjectType] = 'AfterMarket' THEN 'Y' ELSE 'N' END) AS [AftermarketYN],
	  BidFormat, DeliveryMethod,
	  Mun = Mun

FROM
(SELECT [Neptune].[dbo].[tbl00Projects].[ProjectID]
	  ,[Neptune].[dbo].[tbl00Projects].[ProjectName]
	 -- ,[Neptune].[dbo].[tbl09Installation].[Ind_Mun]
      ,[Neptune].[dbo].[tbl00Projects].[Status]
      ,[Neptune].[dbo].[tbl00Projects].[City]
      ,[Neptune].[dbo].[tbl00Projects].[State]
      ,[Neptune].[dbo].[tbl00Projects].[Country]
      ,[Neptune].[dbo].[tbl00Projects].[ProjectType]
	  ,[Neptune].[dbo].[tbl00Projects].[EngineerID]
	  ,CAST([Neptune].[dbo].[tbl00Projects].[QuoteNum] AS int) AS [QuoteNum]  ,
	  mun
  FROM [Neptune].[dbo].[tbl00Projects]
  --  INNER JOIN [Neptune].[dbo].[tbl09Installation]
  --ON [Neptune].[dbo].[tbl00Projects].[ProjectID] = [Neptune].[dbo].[tbl09Installation].[ProjectID]

  Left JOIN
  (Select Company, ProjectID, Description, Character04 , 
Mun = case when Right(left(Character04,5),1) not in ('M','I')  then '' else Right(left(Character04,5),1)  end
from 
[AQUAERPDB].[Epicor10Live].[Erp].[Project] a
left join
[AQUAERPDB].[Epicor10Live].[Erp].[Project_UD] b on a.SysRowID=b.ForeignSysRowID) IM
  ON [Neptune].[dbo].[tbl00Projects].[ProjectID] = IM.[ProjectID]
  WHERE [Neptune].[dbo].[tbl00Projects].[SourceDB] &lt;&gt; 'Deleted'
  AND [Neptune].[dbo].[tbl00Projects].[ProjectID] NOT LIKE '999999%'
  AND [Neptune].[dbo].[tbl00Projects].[ProjectID] NOT IN ('0000','999997','999998A','999998E','999998F','ENUM','lesh','SBR8072')
  AND [Neptune].[dbo].[tbl00Projects].[Status] NOT IN ('Dead','Order','Lost')
  AND (
  ([QuoteNum] LIKE '[0-9][0-9][0-9][0-9][0-9]') OR ([QuoteNum] LIKE '[0-9][0-9][0-9][0-9][0-9][0-9]')
  )) [APD1]

  LEFT OUTER JOIN 
  (SELECT [QuoteNum],[TerritoryID],[DateQuoted],[SysRowID] FROM [AQUAERPDB]."Reports"."dbo"."QuoteHed" WHERE [Company] = 'DD-1') AS [QuoteHed1]
  ON [QuoteHed1].[QuoteNum] = [APD1].[QuoteNum]


  LEFT OUTER JOIN
  (SELECT [QuoteNum],[SalesRepCode],[Name]
  FROM [AQUAERPDB].[Epicor10Live].[Erp].[QSalesRP]
  WHERE [Company] = 'DD-1' AND [PrimeRep] = 1) AS [RepTable]
  ON [APD1].[QuoteNum] = [RepTable].[QuoteNum]

  LEFT OUTER JOIN 
  (SELECT DISTINCT [Company],[TerritoryID],[SalesRepCode] FROM [AQUAERPDB].[Epicor10Live].[Erp].[SalesTRP] WHERE [Company] = 'DD-1') AS [SalesTRP1]
  ON [SalesTRP1].[SalesRepCode] = [RepTable].[SalesRepCode]

  LEFT OUTER JOIN
  (SELECT [Company],[TerritoryID],[TerritoryDesc],[RegionCode] FROM [AQUAERPDB].[Epicor10Live].[Erp].[SalesTer] WHERE [Company] = 'DD-1') AS [SalesTer2]
  ON [SalesTer2].[TerritoryID] = [SalesTRP1].[TerritoryID]

  LEFT OUTER JOIN
  (SELECT [RegionCode],[Description] AS [Region] FROM [AQUAERPDB].[Epicor10Live].[Erp].[Region] WHERE [Company] = 'DD-1') AS [Region2]
  ON [SalesTer2].[RegionCode] = [Region2].[RegionCode]

  LEFT OUTER JOIN
  (SELECT [SalesRepCode],[Name] FROM [AQUAERPDB].[Epicor10Live].[Erp].[SalesRep] WHERE [Company] = 'DD-1') AS [SalesRep1]
  ON [RepTable].[SalesRepCode] = [SalesRep1].[SalesRepCode]

  LEFT OUTER JOIN
  (SELECT [Character06] AS [List],BidFormat=Bidformat_c, 
DeliveryMethod= case when character10 like '%Traditional%' then 'DBB' else character10 end,
[ForeignSysRowID] FROM [AQUAERPDB].[Epicor10Live].[Erp].[QuoteHed_UD]) AS [QuoteHed1UD]
  ON [QuoteHed1].[SysRowID] = [QuoteHed1UD].[ForeignSysRowID]

  WHERE [APD1].[Status] = 'Bid' OR [APD1].[Status] = 'Presel.') AS [MainTable]

  LEFT OUTER JOIN
  (SELECT [PriceTable].[QuoteNum]
		,[PriceTable].[Product]
		,[PriceTable].[TotalGrossSellPrice]
		,[PriceTable].[ExtGross]
		,[PriceTable].[ExtComm]
		,[PriceTable].[ExtCost]
		,[PriceTable].[Margin]
		,(CASE WHEN [PriceTable].[ExtGross] = 0 THEN 0 WHEN [PriceTable].[ExtGross] IS NULL THEN 0
			ELSE [PriceTable].[Margin] / [PriceTable].[ExtGross] END) AS [Price Level],ProdCode
FROM
(SELECT [QuoteDtl1].[QuoteNum]
	  ,[ProdGrup1].[Product]
      ,SUM( [QuoteDtl1].[ExpectedRevenue] ) AS [TotalGrossSellPrice]
      ,SUM( [QuoteDtl1].[SellingExpectedQty] * [QuoteDtl1].[ExpUnitPrice] ) AS [ExtGross]
	  ,SUM( ([QuoteDtl1].[SellingExpectedQty] * [QuoteDtl1].[ExpUnitPrice]) * ([QuoteDtl_UD1].[CommRate]/100) ) AS [ExtComm]
	  ,SUM( [QuoteDtl_UD1].[Cost] ) AS [ExtCost]
	  ,SUM( ([QuoteDtl1].[SellingExpectedQty] * [QuoteDtl1].[ExpUnitPrice]) 
		- (([QuoteDtl1].[SellingExpectedQty] * [QuoteDtl1].[ExpUnitPrice]) * ([QuoteDtl_UD1].[CommRate]/100)) 
		- [QuoteDtl_UD1].[Cost] ) AS [Margin],[QuoteDtl1].ProdCode
	  
FROM
(SELECT [Company],[QuoteNum],[ProdCode],[ExpectedRevenue],[ExpUnitPrice],[SellingExpectedQty],[SysRowID] FROM [AQUAERPDB].[Epicor10Live].[Erp].[QuoteDtl]
 WHERE [Company] = 'DD-1') AS [QuoteDtl1]

 INNER JOIN 
 (SELECT [Number01] AS [CommRate], [Number03] AS [DesignID],[Number04] AS [Cost],[ForeignSysRowID] 
 FROM [AQUAERPDB].[Epicor10Live].[Erp].[QuoteDtl_UD]) AS [QuoteDtl_UD1]
 ON [QuoteDtl1].[SysRowID] = [QuoteDtl_UD1].[ForeignSysRowID]

 LEFT OUTER JOIN 
 (SELECT [ProdCode], [Description] AS [Product] FROM [AQUAERPDB].[Epicor10Live].[Erp].[ProdGrup] WHERE [Company] = 'DD-1') AS [ProdGrup1]
 ON [QuoteDtl1].[ProdCode] = [ProdGrup1].[ProdCode]

 GROUP BY [QuoteDtl1].[QuoteNum],[ProdGrup1].[Product],[QuoteDtl1].ProdCode) AS [PriceTable]) AS [PriceTable1]
  ON [MainTable].[QuoteNum] = [PriceTable1].[QuoteNum]

 



if(@AftermarketYN='Y' and @ByDate='Y') 
(
  select * from @data
  Where Region in(@Region) and Product in (@Product) and  BIDDate Between @Start   and @End   )
  
if(@AftermarketYN&lt;&gt;'Y' and @ByDate='Y') 
(
  select * from @data
 Where AftermarketYN='N' and  Region in(@Region)  and Product in (@Product) and  BIDDate Between @Start  and @End )
  
 
if(@AftermarketYN='Y' and @ByDate&lt;&gt;'Y') 
(
  select * from @data
  Where Region in(@Region) and Product in (@Product)   )
  
if(@AftermarketYN&lt;&gt;'Y' and @ByDate&lt;&gt;'Y') 
(
  select * from @data
 Where AftermarketYN='N' and  Region in(@Region)  and Product in (@Product)  )
  
  </CommandText>
      </Query>
      <Fields>
        <Field Name="AftermarketYN">
          <DataField>AftermarketYN</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProjectName">
          <DataField>ProjectName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
