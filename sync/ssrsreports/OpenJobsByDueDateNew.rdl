<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="aquaerpdb">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=AQUAERPDB;Initial Catalog=Epicor10Live</ConnectString>
        <Prompt>Enter a user name and password to access the data source:</Prompt>
      </ConnectionProperties>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>cdefc0ed-a26c-4c80-9d14-bb011e34755c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="jobhead">
      <Query>
        <DataSourceName>aquaerpdb</DataSourceName>
        <CommandText>select top 100 
DueDate=case when DueDate=ISNULL('',DueDate) then '' else DueDate end ,
JobNum, PartNum, PartDescription, ProdQty,
Company, JobClosed,  
CommentText=Rtrim(LTrim(case when CommentText='' then 'No Comments' else left(CommentText, 250) end)), 
StartDate =case when DueDate=ISNULL(StartDate,'')  then '' else StartDate end,
ReqDueDate 
 from  [dbo].[JobHead]
 where Company='DD-1' AND JobClosed=0 and  year(duedate) &gt;=(year(GETDATE())-1)
 ORDER BY DueDate asc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DueDate">
          <DataField>DueDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="JobNum">
          <DataField>JobNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PartNum">
          <DataField>PartNum</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="PartDescription">
          <DataField>PartDescription</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProdQty">
          <DataField>ProdQty</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Company">
          <DataField>Company</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="JobClosed">
          <DataField>JobClosed</DataField>
          <rd:TypeName>System.Boolean</rd:TypeName>
        </Field>
        <Field Name="CommentText">
          <DataField>CommentText</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="ReqDueDate">
          <DataField>ReqDueDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
